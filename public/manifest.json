{
  "manifest_version": 2,
  "name": "Firefox Smart Bookmarks",
  "version": "0.2.0",
  "description": "Reads your native Firefox bookmarks and uses AI to suggest how to sort and categorize them.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "browser_action": {
    "default_title": "Smart Bookmarks"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  }
}